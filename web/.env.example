# TrainFactory Web Environment Variables
# Copy this file to .env.development or .env.production and modify as needed

# API Base URL (without trailing slash)
VITE_API_BASE_URL=http://localhost:18001

# Dev proxy target (used by Vite when VITE_API_BASE_URL=/api)
VITE_PROXY_TARGET=http://localhost:18001

# Application Title
VITE_APP_TITLE=TrainFactory

# API Request Timeout (milliseconds)
VITE_API_TIMEOUT=30000
