# TrainFactory 环境配置 — 唯一配置源
# 复制为 .env 后根据实际环境修改
# Docker Compose 和后端均从项目根目录读取此文件

# ============ 基础设置 ============
COMPOSE_PROJECT_NAME=trainfactory
VERSION=0.1.0
AUTH_ENABLED=true
JWT_SECRET_KEY=change-me-to-random-string
# Safe local HTTP defaults: every published port is bound to loopback and the
# browser cookie is intentionally non-Secure because the origin is HTTP.
HOST_BIND_ADDRESS=127.0.0.1
# Optional trusted-LAN access to the Web UI only. Leave commented so Web follows
# HOST_BIND_ADDRESS in normal local and public HTTPS deployments.
# WEB_HOST_BIND_ADDRESS=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false
# Public deployment example (TLS terminates at an explicit external reverse
# proxy). Use a real non-loopback interface IP and firewall every direct port
# except the proxy ingress. Trust only the Web proxy container CIDR below.
# HOST_BIND_ADDRESS=192.0.2.10
# HOST_BIND_ADDRESS=0.0.0.0 is also supported, but only with the same HTTPS and
# firewall controls.
# PUBLIC_BASE_URL=https://train.example.com
# AUTH_COOKIE_SECURE=true
# RATE_LIMIT_TRUSTED_PROXIES=172.18.0.4/32
# Bootstrap is used only when authentication is enabled and no active administrator exists.
DEFAULT_ADMIN_USERNAME=admin
# Required for first startup; set at least 32 random characters in .env or a secret store.
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=
SELF_REGISTRATION_ENABLED=false
# Authentication rate limits trust forwarded client IPs only from these proxies.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour
RATE_LIMIT_TRUSTED_PROXIES=172.18.0.4/32
RATE_LIMIT_DEV_TRUSTED_PROXIES=172.18.0.5/32
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_CLEANUP_INTERVAL_HOURS=24
LOG_LEVEL=INFO
APP_TIMEZONE=UTC
# Disabled by default: model repositories cannot execute custom Python code.
# Enable only through trusted operations configuration for vetted legacy models.
ALLOW_MODEL_REMOTE_CODE=false

# User-triggered remote model/dataset download resource limits.
DOWNLOAD_MAX_CONCURRENT_GLOBAL=4
DOWNLOAD_MAX_CONCURRENT_PER_USER=2
MODEL_DOWNLOAD_MAX_BYTES=32212254720
DATASET_DOWNLOAD_MAX_BYTES=10737418240
DOWNLOAD_STORAGE_MAX_BYTES_GLOBAL=214748364800
DOWNLOAD_STORAGE_MAX_BYTES_PER_USER=64424509440
DOWNLOAD_METADATA_TIMEOUT_SECONDS=15
DOWNLOAD_MAX_WORKERS=4

# Long-running training/evaluation/generation task admission limits.
BACKGROUND_TASK_MAX_ACTIVE_GLOBAL=8
BACKGROUND_TASK_MAX_ACTIVE_PER_USER=2
# External sync persisted-storage and generation backlog limits.
SYNC_STORAGE_MAX_BYTES_GLOBAL=21474836480
SYNC_STORAGE_MAX_BYTES_PER_USER=5368709120
SYNC_PENDING_MAX_BATCHES_PER_TASK=1000
SYNC_PENDING_MAX_RECORDS_PER_TASK=1000000
SYNC_GENERATION_MAX_INPUT_BYTES=1073741824
SYNC_MAX_RECORD_BYTES=8388608
SYNC_MAX_FUTURE_SKEW_SECONDS=300
SYNC_BOUNDARY_MAX_IDS=10000
SYNC_BOUNDARY_MAX_BYTES=4194304
SYNC_HISTORICAL_MAX_DOCS=100000
SYNC_HISTORICAL_MAX_BYTES=67108864
# Allow CPU training only when explicitly enabled by the operator.
TRAINING_ALLOW_CPU_FALLBACK=false

# 宿主机 IP（部署容器通过此地址回连 API）
HOST_IP=172.17.0.1
# 宿主机路径映射（API 内路径 ↔ 宿主机路径）
PATH_MAPPINGS=

# ============ 端口 ============
API_HOST=train-factory-api
API_PORT=18000
# Exactly one worker is required while background sync managers run in-process.
API_WORKERS=1
# 开发模式端口（dev profile 使用，避免与生产端口冲突）
API_DEV_PORT=18001
WEB_PORT=3000
WEB_DEV_PORT=3001
# 容器化部署自动分配端口范围
PORT_RANGE_START=9997
PORT_RANGE_END=10100
MILVUS_PORT=19530
MILVUS_GRPC_PORT=9091
XINFERENCE_PORT=9997

# ============ 数据库 ============
# Direct local-compatibility mode: set these values and leave every
# *_SECRET_PATH below empty. Generate distinct URL-safe hexadecimal values;
# keep root and app passwords different. Do not combine direct values with the
# file-backed mode because startup fails closed on mixed secret sources.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER=trainfactory_app
MYSQL_APP_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# File-backed Compose secrets opt-in: leave all corresponding direct secret
# values empty and provide all five paths through an operator-controlled env
# file. Leave these blank in direct mode. The verify/CI materializer writes the
# absolute paths only to its ignored runtime env file.
MYSQL_ROOT_PASSWORD_SECRET_PATH=
MYSQL_APP_PASSWORD_SECRET_PATH=
MYSQL_URL_SECRET_PATH=
JWT_SECRET_KEY_SECRET_PATH=
DEFAULT_ADMIN_PASSWORD_SECRET_PATH=

# ============ 容器内路径 ============
TRAINING_CACHE=/app/cache
MODELS_DIR=/app/models
DATASETS_DIR=/app/data/datasets
OUTPUT_DIR=/app/output

# ============ 模型/数据缓存 ============
HF_HOME=/app/cache/hf_home
HF_DATASETS_CACHE=/app/cache/hf_datasets
HF_ENDPOINT=https://hf-mirror.com
MODELSCOPE_CACHE=/app/cache/modelscope

# ============ 对象存储 (MinIO) ============
STORAGE_BACKEND=local
# Both credentials are required when STORAGE_BACKEND=s3 or the vector profile is started.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=trainfactory
MINIO_CONSOLE_PORT=9001

# ============ 基础镜像 ============
API_BASE_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel@sha256:0cf3402e946b7c384ba943ee05c90b4c5a4a05227923921f2b0918c011cfaf56
API_TEST_BASE_IMAGE=python:3.11-slim@sha256:a630a63cdb314e2d138a2fca3e375e319e8568346ffafac5b980f888630ac4f1
WEB_NODE_BUILD_IMAGE=node:22-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436
WEB_NGINX_IMAGE=nginx:alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752
NODE_IMAGE=node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
MYSQL_IMAGE=mysql:8.0@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.57.0-jammy@sha256:6aca677c27a967caf7673d108ac67ffaf8fed134f27e17b27a05464ca0ace831
NVIDIA_RUNTIME=nvidia
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
QWEN3_RERANK_TRAINER_PATH=/data/code/rerank/qwen3-rerank-trainer

# ============ 向量数据库镜像 ============
MILVUS_IMAGE=milvusdb/milvus:v2.5.4@sha256:081e5471cb53756bd86bf2e2bfbedadec9e87cb181583c6f19410b23a711be00
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.18@sha256:d0a641d5fbcc89678c931a61b7de7b8a1cf097149f135c9c73bc81d076a1494b
MINIO_IMAGE=minio/minio:RELEASE.2024-11-07T00-52-20Z@sha256:ac591851803a79aee64bc37f66d77c56b0a4b6e12d9e5356380f4105510f2332

# ============ 推理框架镜像 ============
VLLM_IMAGE=vllm/vllm-openai:v0.11.0@sha256:014a95f21c9edf6abe0aea6b07353f96baa4ec291c427bb1176dc7c93a85845c
XINFERENCE_IMAGE=xprobe/xinference:v1.13.0@sha256:b5df50f3d04e5f7290cf0c6765b5a2b06ab29657d721cfaa13389a7c1d666291
SGLANG_IMAGE=lmsysorg/sglang:v0.5.16@sha256:7b6a35df9839fd593a94a1eaee82d7777f472225d9f3ad1f8a2e0cb2bd1785d0

# ============ Docker 卷名 ============
MYSQL_DATA_VOLUME=trainfactory_mysql_data
ETCD_DATA_VOLUME=trainfactory_etcd_data
MINIO_DATA_VOLUME=trainfactory_minio_data
MILVUS_DATA_VOLUME=trainfactory_milvus_data
TRAIN_CACHE_VOLUME=trainfactory_train_cache
WEB_NODE_MODULES_VOLUME=trainfactory_web_node_modules
E2E_NODE_MODULES_VOLUME=trainfactory_e2e_node_modules
XINFERENCE_CACHE_VOLUME=trainfactory_xinference_cache
XINFERENCE_HOME_VOLUME=trainfactory_xinference_home
DOCKER_NETWORK_NAME=trainfactory_network
DOCKER_NETWORK_SUBNET=172.18.0.0/16
DOCKER_DYNAMIC_IP_RANGE=172.18.128.0/17
WEB_PROXY_IPV4=172.18.0.4
WEB_DEV_PROXY_IPV4=172.18.0.5

# ============ 可选集成 ============
SWANLAB_API_KEY=
MEMOS_API_KEY=
MEMOS_USER_ID=
MEMOS_CHANNEL=MODELSCOPE

# 允许 discover-models 访问的私网主机白名单（逗号分隔，仅主机/IP，不含协议和端口）
# 默认会自动允许：系统默认推理 endpoint + 当前用户已有 deployment 的 endpoint 主机
# 示例: DISCOVER_MODELS_ALLOWED_PRIVATE_HOSTS=10.0.0.5,10.0.0.6,internal-infer.local
DISCOVER_MODELS_ALLOWED_PRIVATE_HOSTS=
# 开发模式可设为 true，放开所有 RFC1918 私网地址（仍会拦截 localhost/环回/链路本地/保留地址）
# 生产环境强烈建议保持 false，并通过 DISCOVER_MODELS_ALLOWED_PRIVATE_HOSTS 精确放行
DISCOVER_MODELS_ALLOW_PRIVATE_ALL=false
